{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "f1-latest/1",
  "title": "F1 latest.json",
  "description": "Names the current product set; written last, atomically, by every tick that changes anything (F1 spec Module 7). Map layers are headerless little-endian arrays on the map grid, described entirely by their entry here.",
  "type": "object",
  "required": ["schema", "set_id", "set_path", "written_at", "provenance", "default_place",
               "places", "grid", "layers", "runs", "sunset_maps"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "f1-latest/1"},
    "set_id": {"$ref": "#/$defs/set_id"},
    "set_path": {"type": "string", "pattern": "^sets/[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}/$"},
    "written_at": {"$ref": "#/$defs/utc_time"},
    "provenance": {
      "type": "object",
      "required": ["commit", "config_hash", "software"],
      "additionalProperties": false,
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "config_hash": {"$ref": "#/$defs/sha256"},
        "software": {
          "type": "object",
          "required": ["astroseeing"],
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "default_place": {"$ref": "#/$defs/id"},
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "file"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "file": {"type": "string", "pattern": "^place-[a-z][a-z0-9_]*\\.json$"}
        }
      }
    },
    "grid": {
      "type": "object",
      "required": ["crs", "lat_north", "lon_west", "dlat", "dlon", "nlat", "nlon", "order"],
      "additionalProperties": false,
      "properties": {
        "crs": {"const": "EPSG:4326"},
        "lat_north": {"type": "number", "minimum": -90, "maximum": 90},
        "lon_west": {"type": "number", "minimum": -180, "maximum": 180},
        "dlat": {"type": "number", "exclusiveMinimum": 0},
        "dlon": {"type": "number", "exclusiveMinimum": 0},
        "nlat": {"type": "integer", "minimum": 1},
        "nlon": {"type": "integer", "minimum": 1},
        "order": {"const": "row-major, north to south, west to east"}
      }
    },
    "layers": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/layer"}
    },
    "runs": {
      "description": "The run each forecast model's values come from; a model with no run yet is absent.",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {
        "type": "object",
        "required": ["run_id", "run_time", "state", "stale"],
        "additionalProperties": false,
        "properties": {
          "run_id": {"type": "integer", "minimum": 1},
          "run_time": {"$ref": "#/$defs/utc_time"},
          "state": {"enum": ["seen", "fetching", "fetched", "verified", "processed",
                             "partial", "failed", "abandoned"]},
          "stale": {"type": "boolean"}
        }
      }
    },
    "sunset_maps": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["night", "path"],
        "additionalProperties": false,
        "properties": {
          "night": {"$ref": "#/$defs/date"},
          "path": {"type": "string", "pattern": "^sunset/[0-9]{4}-[0-9]{2}-[0-9]{2}/$"}
        }
      }
    },
    "paranal_check": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {"file": {"const": "paranal-check.json"}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "set_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "utc_time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "layer": {
      "type": "object",
      "required": ["file", "dtype", "shape", "sha256"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.(u8|u16|i16)$"},
        "dtype": {"enum": ["uint8", "uint16", "int16"]},
        "shape": {
          "description": "The array's shape, row-major: [nlat, nlon], or [hours, nlat, nlon] for a layer with hours.",
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {"type": "integer", "minimum": 1}
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "codes": {
          "description": "Reserved values and their meaning, e.g. 255 = no counted hours.",
          "type": "object",
          "propertyNames": {"pattern": "^-?[0-9]+$"},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "scale": {"description": "Stored value × scale = value in units.", "type": "number", "exclusiveMinimum": 0},
        "units": {"type": "string"},
        "hours": {
          "description": "For a layer shaped (hour, lat, lon): the UTC hours, in order.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/utc_time"}
        }
      }
    }
  }
}
